# ===================================================
# Load Shedding & Power Outage Management System - Environment Variables
# ===================================================

# Database (PostgreSQL - Neon Serverless compatible)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Redis Cache (Upstash Redis or local Redis)
REDIS_URL="redis://default:sample_password@us1-sample-redis.upstash.io:6379"

# Authentication & JWT
AUTH_SECRET="super-secret-cryptographically-secure-jwt-key-replace-in-production-min-32-chars"
AUTH_URL="http://localhost:3000"

# Express API Server
API_PORT=4000
API_BASE_URL="http://localhost:4000"
BACKEND_URL="http://localhost:4000"

# Next.js Frontend
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Twilio SMS Service (Leave blank for simulated development SMS logging)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email Service (Verification & Password Reset)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@grid.gov.bd"

# File Upload Storage
UPLOAD_STORAGE_PROVIDER="local"
UPLOAD_STORAGE_BUCKET="uploads"

# Runtime Environment
NODE_ENV="development"
